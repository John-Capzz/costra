# Runtime mode: development, test, staging, or production.
COSTRA_ENV=development

# PostgreSQL authentication persistence. Use DATABASE_URL or all PG* fields.
DATABASE_URL=postgresql://costra_user:replace_me@localhost:5432/costra

# Alternative to DATABASE_URL:
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=costra
# PGUSER=costra_user
# PGPASSWORD=replace_me

# Set to true only when the PostgreSQL server requires TLS.
PGSSL=false

# Optional, explicit Arc Testnet execution configuration.
# Never commit a real private key. Ordinary tests do not submit transactions.
# ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.io
# ARC_TESTNET_CHAIN_ID=5042002
# ARC_TESTNET_EXECUTION_PRIVATE_KEY=0xreplace_with_a_dedicated_testnet_key

# Frontend-safe configuration. Do not put API keys or other backend secrets in VITE_* values.
# VITE_COSTRA_API_BASE_URL=http://localhost:3001/api/v1
