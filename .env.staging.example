# Copy to a secret-managed staging environment; do not commit a populated copy.
COSTRA_ENV=staging
PORT=3001
CORS_ORIGIN=https://staging.example.com

# Use a staging-only PostgreSQL database.
DATABASE_URL=postgresql://staging_user:replace_me@staging-db.internal:5432/costra_staging
PGSSL=true

# Arc Testnet only. The private key must be injected by the runtime secret manager.
ARC_TESTNET_RPC_URL=https://replace-with-arc-testnet-rpc.example
ARC_TESTNET_CHAIN_ID=5042002
ARC_TESTNET_EXECUTION_PRIVATE_KEY=0xreplace_with_a_64_hex_testnet_key
ARC_TESTNET_EXECUTION_ADDRESS=0xreplace_with_the_matching_wallet_address

# Frontend build-time configuration; this is not a secret.
VITE_COSTRA_API_BASE_URL=https://staging-api.example.com/api/v1
